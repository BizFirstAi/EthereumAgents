    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BizFirst.Integration.Ethereum.Domain\BizFirst.Integration.Ethereum.Domain.csproj" />
